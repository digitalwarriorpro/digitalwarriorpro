# Copy to .env.local and fill in from Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the service_role key (server-side only; never ship it to the browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Set to true to require a Supabase user access token (Authorization: Bearer <jwt>)
REQUIRE_AUTH=false
